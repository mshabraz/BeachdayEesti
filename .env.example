# Server
HOST=0.0.0.0
PORT=8080

# Estonian Environment Agency public weather API (no key required)
# Docs: https://ilmmicroservice.envir.ee/api_doc/  (apidoc; examples use publicapi.envir.ee)
ENVIR_API_BASE=https://publicapi.envir.ee
API_DOC_URL=https://ilmmicroservice.envir.ee/api_doc/

# XML fallback if public API is unreachable
OBSERVATIONS_XML=https://www.ilmateenistus.ee/ilma_andmed/xml/observations.php?lang=eng
FORECAST_XML=https://www.ilmateenistus.ee/ilma_andmed/xml/forecast.php?lang=eng

# Set to true only if HTTPS fails due to corporate proxy certificates
TLS_INSECURE=false
